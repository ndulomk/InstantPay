NODE_ENV=development
PORT=9999
HOST=0.0.0.0

# Usa DATABASE_URL ou as variáveis DB_* (uma das duas formas).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/instantpay
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=instantpay
# DB_SSL=false

# Obrigatório — mínimo 32 caracteres.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

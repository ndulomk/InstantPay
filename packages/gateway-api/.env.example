NODE_ENV=development
PORT=9998
HOST=0.0.0.0

# Usa DATABASE_URL ou as variáveis DB_* (uma das duas formas).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/instantpay
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=instantpay
# DB_SSL=false

# Obrigatório — mínimo 16 caracteres.
GATEWAY_ADMIN_TOKEN=change-me-gateway-admin-token

CORE_BANKING_URL=http://localhost:9999
# PAYMENT_PROCESSOR_URL=http://localhost:9997
# FRAUD_DETECTION_URL=http://localhost:9996
# NOTIFICATION_SERVICE_URL=http://localhost:9995
# RECONCILIATION_URL=http://localhost:9994
# ADMIN_DASHBOARD_URL=http://localhost:9993

UPSTREAM_TIMEOUT_MS=10000

NODE_ENV=development
PORT=9993
HOST=0.0.0.0

# Usa DATABASE_URL ou as variáveis DB_* (uma das duas formas).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/instantpay
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=instantpay
# DB_SSL=false

ADMIN_DEFAULT_HEALTH_TIMEOUT_MS=3000
ADMIN_SANDBOX_TIMEOUT_MS=15000

# Necessário para o laboratório criar e revogar API keys temporárias no gateway.
GATEWAY_ADMIN_TOKEN=change-me-gateway-admin-token

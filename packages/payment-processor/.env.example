NODE_ENV=development
PORT=9997
HOST=0.0.0.0

# Usa DATABASE_URL ou as variáveis DB_* (uma das duas formas).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/instantpay
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=instantpay
# DB_SSL=false

PAYMENT_PROVIDER=mock
PAYMENT_DEFAULT_CURRENCY=AOA
# Obrigatório — mínimo 16 caracteres.
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

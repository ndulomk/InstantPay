# Copy to `.env` at the repository root (or export the variables) before
# running `docker compose up`. The defaults in docker-compose.yml are intended
# for local development only.

# Docker Hub account used by docker-compose.yml and docker/publish.sh.
DOCKERHUB_USER=eddiendulo
TAG=latest

POSTGRES_PORT=55432
POSTGRES_PASSWORD=postgres

# Must be at least 32 characters in production.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-chars

# Must be at least 16 characters.
GATEWAY_ADMIN_TOKEN=change-me-gateway-admin-token
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

PAYMENT_PROVIDER=mock
PAYMENT_DEFAULT_CURRENCY=AOA

FRAUD_REVIEW_THRESHOLD=50
FRAUD_BLOCK_THRESHOLD=80

NOTIFICATION_PROVIDER=mock
NOTIFICATION_MAX_ATTEMPTS=3

RECONCILIATION_DATE_WINDOW_DAYS=3

LOG_LEVEL=info
